---
import type { CommandSpec } from '../data/manifest';
interface Props { specs: CommandSpec[] }
const { specs } = Astro.props;
---
<!-- Hidden until the script runs: without JavaScript the index links are the
     navigation, and a dead input would be worse than no input. -->
<div class="prompt" id="prompt" hidden>
  <label class="sr-only" for="prompt-input">Command</label>
  <div class="output" id="prompt-output" role="log" aria-live="polite"></div>
  <div class="prompt-line">
    <span class="sigil" aria-hidden="true">$</span>
    <span class="field">
      <input
        id="prompt-input"
        type="text"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        maxlength="48"
      />
      <span class="caret" aria-hidden="true"></span>
    </span>
    <span class="hint" aria-hidden="true">[?] for help</span>
  </div>
</div>

<script is:inline define:vars={{ specs }}>
(() => {
  const root = document.getElementById('prompt');
  const input = document.getElementById('prompt-input');
  const out = document.getElementById('prompt-output');
  const field = root.querySelector('.field');
  if (!root || !input || !out) return;
  root.hidden = false;

  const byName = new Map();
  for (const s of specs) {
    byName.set(s.command, s);
    for (const a of s.aliases) byName.set(a, s);
  }
  const visible = specs.filter((s) => !s.hidden);

  // Pages the previous version of this site had. Answering them properly is
  // the joke: the absence is the point.
  const GHOSTS = ['about', 'cv', 'blog', 'now', 'reading', 'studies', 'links', 'lists', 'chess'];

  const write = (text, cls) => {
    const line = document.createElement('div');
    if (cls) line.className = cls;
    line.textContent = text;
    out.appendChild(line);
  };
  const echo = (text) => write('$ ' + text, 'echo');
  const go = (href, external) => {
    if (external) window.open(href, '_blank', 'noopener');
    else window.location.href = href;
  };

  const pad = (s, n) => s + ' '.repeat(Math.max(1, n - s.length));

  const distance = (a, b) => {
    const m = Array.from({ length: b.length + 1 }, (_, i) => [i, ...Array(a.length).fill(0)]);
    for (let j = 0; j <= a.length; j++) m[0][j] = j;
    for (let i = 1; i <= b.length; i++)
      for (let j = 1; j <= a.length; j++)
        m[i][j] = Math.min(m[i - 1][j] + 1, m[i][j - 1] + 1, m[i - 1][j - 1] + (a[j - 1] === b[i - 1] ? 0 : 1));
    return m[b.length][a.length];
  };

  // ── sl ────────────────────────────────────────────────────────────────
  // Typing `sl` is, as ever, punished with a train. Drawn in the same
  // box-drawing glyphs as the rest of the site, so it runs along the grid.
  const TRAIN = [
    '     ┌──╨─╨──┐   ┌────────────┐   ┌────────────┐',
    '     │ ┌───┐ │   │ ┌──┐ ┌──┐  │   │ ┌──┐ ┌──┐  │',
    '     │ └───┘ │   │ └──┘ └──┘  │   │ └──┘ └──┘  │',
    '     └─○───○─┘   └──○──────○──┘   └──○──────○──┘',
  ];
  const CHIMNEY = '        ╔═╗                                     ';
  const SMOKE = [
    [
      '          o                                     ',
      '        o                                       ',
      '         o                                      ',
    ],
    [
      '        o                                       ',
      '         o                                      ',
      '          o                                     ',
    ],
  ];
  const frame = (i) => [...SMOKE[i], CHIMNEY, ...TRAIN].join('\n');

  let running = false;
  const sl = () => {
    if (running) return;
    // Someone who asked not to be moved gets the train standing still.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      write(frame(0));
      return;
    }
    running = true;
    const el = document.createElement('pre');
    el.className = 'sl';
    el.setAttribute('aria-hidden', 'true');
    el.textContent = frame(0);
    document.body.appendChild(el);
    let i = 0;
    const puff = window.setInterval(() => {
      i = 1 - i;
      el.textContent = frame(i);
    }, 240);
    el.addEventListener('animationend', () => {
      window.clearInterval(puff);
      el.remove();
      running = false;
    });
  };

  const HELP = [
    ['ls', 'list what is here'],
    ['<name>', 'go there'],
    ['clear', 'clear this'],
  ];

  const run = (raw) => {
    const line = raw.trim();
    if (!line) return;
    echo(line);
    const [cmd, ...rest] = line.split(/\s+/);
    const arg = rest.join(' ');
    const name = cmd.toLowerCase();

    if (name === 'clear') { out.replaceChildren(); return; }
    if (name === 'sl') { sl(); return; }

    if (name === 'help' || name === '?') {
      write('pages', 'dim');
      for (const s of visible) write('  ' + pad(s.command, 13) + s.blurb);
      write('');
      write('commands', 'dim');
      for (const [c, d] of HELP) write('  ' + pad(c, 13) + d);
      write('');
      write('tab completes. up and down recall.', 'dim');
      return;
    }

    if (name === 'ls') {
      for (const s of visible) write(s.command + (s.external ? ' -> ' + s.href : ''));
      return;
    }

    if (byName.has(name)) {
      const s = byName.get(name);
      write(s.external ? 'opening ' + s.href + '…' : 'opening ' + s.href, 'dim');
      go(s.href, s.external);
      return;
    }

    if (name === 'sudo') { write('nice try.', 'err'); return; }
    if (name === 'whoami') { write('guest'); return; }
    if (name === 'pwd') { write(window.location.pathname); return; }
    if (name === 'cd') {
      if (!arg || arg === '..' || arg === '~' || arg === '/') { go('/', false); return; }
      return run(arg);
    }
    if (name === 'man') { write('man: it is a website. click something.', 'dim'); return; }
    if (name === 'exit' || name === 'quit') { write('there is no exit. there is a back button.', 'dim'); return; }
    if (name === 'echo') { write(arg); return; }
    if (name === 'date') { write(new Date().toDateString().toLowerCase()); return; }
    if (name === 'uname') { write('paper'); return; }

    if (GHOSTS.includes(name)) {
      write(name + ': no such file or directory', 'err');
      write('there used to be. it was a lot about me.', 'dim');
      return;
    }

    const near = visible
      .map((s) => [s.command, distance(name, s.command)])
      .filter(([, d]) => d <= 2)
      .sort((a, b) => a[1] - b[1])[0];
    write(name + ': command not found', 'err');
    if (near) write('did you mean ' + near[0] + '?', 'dim');
  };

  // The caret is a block sitting at the character offset — trivial in a
  // monospace, and it keeps the native caret from breaking the grid.
  const syncCaret = () => {
    field.style.setProperty('--col', String(input.selectionStart ?? input.value.length));
  };
  for (const ev of ['input', 'keyup', 'click', 'focus', 'select']) {
    input.addEventListener(ev, syncCaret);
  }
  input.addEventListener('focus', () => root.classList.remove('is-blurred'));
  input.addEventListener('blur', () => root.classList.add('is-blurred'));
  root.classList.add('is-blurred');

  const history = [];
  let hIndex = -1;

  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const v = input.value;
      if (v.trim()) { history.push(v.trim()); hIndex = history.length; }
      run(v);
      input.value = '';
      syncCaret();
      root.scrollIntoView({ block: 'nearest' });
      return;
    }
    if (e.key === 'Tab') {
      e.preventDefault();
      const stem = input.value.trim().toLowerCase();
      if (!stem) return;
      const hits = visible.map((s) => s.command).filter((c) => c.startsWith(stem));
      if (hits.length === 1) { input.value = hits[0]; syncCaret(); }
      else if (hits.length > 1) { echo(stem); write(hits.join('  ')); }
      return;
    }
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (!history.length) return;
      hIndex = Math.max(0, hIndex - 1);
      input.value = history[hIndex];
      syncCaret();
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (!history.length) return;
      hIndex = Math.min(history.length, hIndex + 1);
      input.value = history[hIndex] ?? '';
      syncCaret();
    }
  });

  // Typing anywhere on the page goes to the prompt — the terminal courtesy.
  document.addEventListener('keydown', (e) => {
    if (e.target === input) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const tag = (e.target instanceof HTMLElement ? e.target.tagName : '') || '';
    if (tag === 'INPUT' || tag === 'TEXTAREA') return;
    if (e.key.length === 1 || e.key === '?') {
      input.focus();
      syncCaret();
    }
  });

  syncCaret();
})();
</script>
